<% include partials/header.ejs %>
<div class="container">
  <% if(searchedSongs.length <= 0) {%>

  <h2 class="nokora-font mt-5">
    <!-- មិនទាន​មាន​បទ​ចម្រៀង​នៅ​ក្នុង​សៀវភៅ​  -->
    រក​ឃើញ
    <%= searchedSongs.length %> បទ ដែល​មាន​អក្សរ លេខ​ឬពាក្យ
    <%= searchTerm %>


    <!-- ​​នៅ​ឡើយ​ទេ! -->
  </h2>

  <hr />
  <div class="row">
    <div class="col-md-12">
      <div class="col-md-3">
        <% if(isUser) {%>
        <a class="btn btn-primary btn-block" href="/song/new">Add new song to this book?</a>
        <%}%>
      </div>
    </div>
  </div>
  <% } else { %>
  <h2 class="title-size-1 mt-5">
    រក​ឃើញ
    <%= searchedSongs.length %> បទ ដែល​មាន​អក្សរ លេខ​ឬពាក្យ
    <%= searchTerm %>
  </h2>
  ​
  <div class="row">
    <div class="col-md-12">
      <table class="table">
        <thead>
          <tr class="content-font">
            <th scope="col">#</th>
            <th scope="col">ចំណង​ជើងខ្មែរ</th>
            <th scope="col">ចំណង​ជើងអង់គ្លេស</th>
            <th>ក្នុង​សៀវភៅ</th>

            <th scope="col">មើល</th>
          </tr>
        </thead>
        <tbody>
          <% searchedSongs.forEach((song)=> { %>
          <tr class="table">
            <th scope="row">
              <%= song.songId %>
            </th>
            <td>
              <%= song.songTitleKh %>
            </td>
            <td>
              <%= song.songTitleEn %>
            </td>
            <td>
              <a href="/book/<%=song.book.id%>/song">
                <%= song.book.bookName %></a>
            </td>

            <td><a href="/song/<%= song._id %>" class="btn btn-primary btn-sm"><i class="fas fa-eye"></i></a></td>
          </tr>
          <%}) }%>
        </tbody>
      </table>
    </div>
    <!-- <div class="col-md-4">
      <h3>Sidebar</h3>
    </div> -->
  </div>

  <!-- if book has more than 10 song show pagination otherwise don't show -->

  <% if(searchedSongs.length > 10) { %>

  <div class="row">
    <div class="col-lg mt-5">
      <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center">
          <li class="page-item">
            <a class="page-link" href="#" aria-label="Previous">
              <span aria-hidden="true">&laquo;</span>
            </a>
          </li>
          <li class="page-item"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item">
            <a class="page-link" href="#" aria-label="Next">
              <span aria-hidden="true">&raquo;</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <%}%>
</div>

<% include partials/footer.ejs %>