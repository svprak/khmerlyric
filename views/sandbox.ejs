<%- include("partials/header.ejs") %>
<div class="container">
  <h3 class="text-center">Sand Box</h3>
  <% if(songlists.length <= 0) {%>

  <h2 class="nokora-font mt-5 warning">
    <!-- <i class="far fa-hand-paper"></i>--><i class="fas fa-hand-paper"></i>
    ដល់​ទំពរ័​ចុង​ក្រោយ​ហើយ!
  </h2>

  <hr />
  <div class="row">
    <div class="col-md-12">
      <a class="btn btn-primary" href="/song">Back</a>
      <a class="btn btn-primary float-right" href="/song/new"
        >Add new song to this book?</a
      >
    </div>
  </div>
  <% } else { %>
  <h2 class="taprom-font mt-5"></h2>
  <h5 class="taprom-font pt-3">
    <i class="fas fa-clipboard-list"></i> បញ្ជី​បទ​ចម្រៀង
  </h5>

  <div class="row">
    <div class="col-lg">
      <table class="table">
        <thead>
          <tr class="taprom-font">
            <th>#</th>
            <th>ចំណង​ជើងខ្មែរ</th>
            <th>ចំណង​ជើងអង់គ្លេស</th>
            <th>ក្នុង​សៀវភៅ</th>
            <th>និពន្ធដោយ</th>
            <th>មើល</th>
          </tr>
        </thead>
        <tbody>
          <% songlists.forEach((song)=> { %>
          <tr class="table-row-highlight content-font">
            <th scope="row"><%= song.songId %></th>
            <td><%= song.songTitleKh %></td>
            <td><%= song.songTitleEn %></td>
            <td>
              <a href="/book/<%=song.book.id%>/song">
                <%= song.book.bookName %></a
              >
            </td>
            <td><%= song.songBy %></td>
            <td>
              <a
                class="btn btn-primary btn-sm"
                alt="View Song"
                title="Views Song"
                href="/song/<%= song._id %>"
                ><i class="fas fa-eye"></i
              ></a>
              <% if(isUser) {%>
              <form action="/song/<%= song._id %>?_method=DELETE" method="POST">
                <a
                  class="btn btn-sm btn-warning"
                  alt="Edit Song"
                  data-toggle="tooltip"
                  title="Edit Song"
                  href="/song/<%= song._id %>/edit"
                >
                  <i class="fas fa-pencil-alt"></i
                ></a>
                <button
                  class="btn btn-sm btn-danger float-right"
                  alt="Delete Song"
                  data-toggle="tooltip"
                  title="Delete Song"
                >
                  <i class="fas fa-remove"></i>
                </button>
              </form>
              <%}%>
            </td>
          </tr>
          <%}) }%>
        </tbody>
      </table>
    </div>
  </div>

  <!-- if book has more than 10 song show pagination otherwise don't show -->
  <% include partials/showmore.ejs %>
</div>

<%- include("partials/footer.ejs") %>
