<% include partials/header.ejs %>
<div class="container">
  <% if(songlists.length <= 0) {%>

  <h2 class="nokora-font mt-5">
    មិនទាន​មាន​បទ​ចម្រៀង​នៅ​ក្នុង​សៀវភៅ​
    <span class="bookTitle">
      <%= songBook %>
    </span>
    ​​នៅ​ឡើយ​ទេ!
  </h2>

  <hr />
  <div class="row">
    <div class="col-md-12">
      <a class="btn btn-primary " href="/book">Back</a>
      <a class="btn btn-primary  float-right" href="/song/new">Add new song to this book?</a>
    </div>
  </div>
  <% } else { %>

  <div class="row">
    <h5 class="mt-3">
      បទ​ចម្រៀង​សរុបមាន:
      <%= songlists.length %> បទ
    </h5>
    <div class="col-md-12">
      <table class="table">
        <thead>
          <tr>
            <th>#</th>
            <th>ចំណង​ជើងខ្មែរ</th>
            <th>ចំណង​ជើងអង់គ្លេស</th>
            <th>ក្នុង​សៀវភៅ</th>
            <!-- <th>និពន្ធដោយ</th> -->
            <th class="text-center">មើល</th>
          </tr>
        </thead>
        <tbody>
          <% songlists.forEach((song)=> { %>
          <tr class="table-row-highlight content-font">
            <th scope="row">
              <%= song.songId %>
            </th>
            <td>
              <%= song.songTitleKh %>
            </td>
            <td>
              <%= song.songTitleEn %>
            </td>
            <td>
              <a alt="View Song" title="Views Song" href="/book/<%= song.book.id %>/song">
                <%= song.book.bookName %></a> </td>
            <td class="text-center">
              <a class="btn btn-primary btn-sm" alt="View Song" title="Views Song" href="/song/<%= song._id %>"><i
                  class="fas fa-eye"></i></a>
              <% if(isUser) {%>
              <form action="/song/<%= song._id %>?_method=DELETE" method="POST" id="delete-form">
                <a class="btn btn-sm btn-warning btn-sm" alt="Edit Song" data-toggle="tooltip" title="Edit Song" href="/song/<%= song._id %>/edit">
                  <i class="fas fa-pencil-alt"></i></a>
                <button class="btn btn-sm btn-danger" alt="Delete Song" data-toggle="tooltip" title="Delete Song">
                  <i class="fas fa-remove"></i>
                </button>
              </form>
              <%}%>
            </td>
          </tr>
          <%}) }%>
        </tbody>
      </table>
    </div>
  </div>

  <!-- if book has more than 10 song show pagination otherwise don't show -->

  <% if(songlists.length > 10) { %>

  <div class="row">
    <div class="col-lg mt-5">
      <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center">
          <li class="page-item">
            <a class="page-link" href="#" aria-label="Previous">
              <span aria-hidden="true">&laquo;</span>
            </a>
          </li>
          <li class="page-item"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item">
            <a class="page-link" href="#" aria-label="Next">
              <span aria-hidden="true">&raquo;</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <%}%>
</div>

<% include partials/footer.ejs %>