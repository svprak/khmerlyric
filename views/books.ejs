<%- include("partials/header.ejs") %>
<div class="container">
  <% if(songbooks.length <=0) { %>
  <h1 class="mt-5">- Number of Book : <%= bookCount %></h1>
  <p>Welcome to</p>
  <hr />
  <div class="row">
    <div class="col-md-12">
      <p class="book-title-3">
        No book is available to select.
        <a href="/book/new">Add new song book?</a>
      </p>
    </div>
  </div>
  <% } else { %>
  <h3 class="mt-3 content-font">
    សៀវភៅចម្រៀងសរសើរ​ព្រះ​ជា​ខេមរភាសាមាន <%= bookCount %> ក្បាល
  </h3>

  <hr />
  <div class="row">
    <% songbooks.forEach((songbook)=>{ %>

    <div class="col-md-2">
      <div class="card mb-4">
        <a class="link" href="/book/<%= songbook._id %>/song">
          <img
            src="<%= songbook.bookCoverImg %>"
            class="card-img-top img-fluid"
            alt="<%= songbook.bookName %>"
        /></a>
        <div class="card-body content-font p-2">
          <h5 class="card-title descrition pt-2">
            <a class="link" href="/book/<%= songbook._id %>/song">
              <%= songbook.bookName %></a
            >
          </h5>

          <!-- <p class="card-text">
            <%- songbook.bookDescription.slice(0,125) %>...
          </p> -->
          <% if(isUser && isUser.role.admin) {%>
          <div class="operation">
            <form
              action="/book/<%= songbook._id %>?_method=DELETE"
              method="POST"
            >
              <button class="btn btn-sm btn-danger">
                <i class="fas fa-remove"></i>
              </button>
              <a
                class="btn btn-sm btn-warning float-right"
                href="/book/<%= songbook._id %>/edit"
              >
                <div><i class="fas fa-pencil-alt"></i></div>
              </a>
            </form>
          </div>
          <%}%>
        </div>
      </div>
    </div>
    <% }) } %>
  </div>
  <%- include("partials/footer.ejs") %>
</div>
